{
    "DebianPackageName": "{{name}}-{{version}}.deb",
    "AppRunPackageName": "{{filename}}.apprunx",
    "DependencyBuilds": [
        "AppRun"
    ],
    "Build": [
        "core-skel",
        "branding-common",
        "gnome-extensions",
        "enterprise",
        "enterprise-gnome",
        "nodejs"
    ],
    "TextSubstitute": {
        "EDITION_DISPLAY": "Workstation Enterprise",
    }
}