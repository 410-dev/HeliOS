{
    "DebianPackageName": "{{name}}-{{version}}.deb",
    "AppRunPackageName": "{{filename}}.apprunx",
    "DependencyBuilds": [
        "AppRun"
    ],
    "Build": [
        "core-skel",
        "branding-common",
        "branding-enterprise",
        "gnome-extension",
        "enterprise"
    ],
    "TextSubstitute": {
        "EDITION_DISPLAY": "Enterprise",
    }
}