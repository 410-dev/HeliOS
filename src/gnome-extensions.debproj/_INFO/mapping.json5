{
    // 여기의 K/V 를 소스코드에서 치환함. {{key}} -> value 로 치환
    "docs": "/usr/lib/helios/docs",
    "root-skel": "/",
    "gnome-context-menu-extensions": "/usr/share/nautilus-python/extensions",
    "commands/autocompletes": "/usr/lib/helios/commands/autocompletes",
    "commands/exec": "/usr/bin",
    "commands/manuals": "/usr/lib/helios/commands/manuals",
    "gnome-shell-extensions": "/usr/share/gnome-shell/extensions",
//    "xdg-autostart": "/etc/xdg/autostart" // 현재 사용 안 함. 나중에 필요하면 추가
}